{
  "name": "eureka-highlight-your-bookmarks",
  "version": "0.1.0",
  "description": "A modern Chrome extension that highlights your bookmarked links",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test --test-concurrency=2 \"test/*.test.js\"",
    "test:integration": "npm run build && playwright test --project=integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "chrome-extension",
    "bookmarks",
    "highlight",
    "browser-extension"
  ],
  "author": "",
  "license": "MIT"
}
